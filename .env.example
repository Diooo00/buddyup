# BuddyUp – AI Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# OpenAI-compatible API key (required for Stage 4 AI Chat)
OPENAI_API_KEY=your_api_key_here

# Optional: custom base URL for OpenAI-compatible providers
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: model override (default: gpt-4o-mini)
# NEXT_PUBLIC_AI_MODEL=gpt-4o-mini
